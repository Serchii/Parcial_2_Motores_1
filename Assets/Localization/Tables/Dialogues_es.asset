%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogues_es
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 796f93bda3901054ba604642844f6db3, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 47378403328
    m_Localized: "Henry:\n \xA1\xBFQu\xE9 carajos?! Me debo haber desmayado del cansancio.
      \xA1Mejor me voy corriendo!"
    m_Metadata:
      m_Items: []
  - m_Id: 535989653504
    m_Localized: "Henry:\n Mmm, \xA1suena prometedor! Ser\xE1 mejor que me vaya antes
      de que se den cuenta de que sigo aqu\xED\xAD. Debo encontrar la casa de esa
      mujer\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 419283144704
    m_Localized: "Voz desconocida:\n \xBFYa se fue ese chico? No quiero que nadie
      nos escuche."
    m_Metadata:
      m_Items: []
  - m_Id: 523977166848
    m_Localized: "Propietario:\n \xA1S\xED! \xA1Se debe haber ido hace horas! \xA1Ya
      dilo! \xBFQu\xE9 haremos esta noche?"
    m_Metadata:
      m_Items: []
  - m_Id: 531073929216
    m_Localized: "Voz desconocida:\n Bueno, el jefe plane\xF3 el secuestro de la
      hija de esa se\xF1ora adinerada al final de la calle\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 3359803132416000
    m_Localized: "Propietario:\n \xA1Ey, muchacho! Sube y arregla el ba\xF1o. No
      te metas en las dem\xE1s habitaciones, a la due\xF1a no le gusta nada. \xA1Te
      pagar\xE9 cuando termines!"
    m_Metadata:
      m_Items: []
  - m_Id: 3378980756983808
    m_Localized: "Henry:\n Bueno, al fin termino. Tanto trabajo me dej\xF3 exhausto."
    m_Metadata:
      m_Items: []
  - m_Id: 4813628221493248
    m_Localized: "Henry:\n Uf, estuvo cerca. Por poco no la cuento.\n Mejor me voy
      antes de quedar involucrado cuando llegue la polic\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 4814995682037760
    m_Localized: "Secuestrador:\n Vamos, fuercen la puerta. Debemos terminar antes
      que nos vea alguien."
    m_Metadata:
      m_Items: []
  - m_Id: 4815051789242368
    m_Localized: "Secuestrador:\n \xBFY t\xFA qui\xE9n eres? No te metas donde no
      te llaman.\n \xA1Muchachos, a \xE9l!"
    m_Metadata:
      m_Items: []
  - m_Id: 4815036924628992
    m_Localized: "Henry:\n \xA1Basta! Det\xE9nganse si no quieren salir heridos."
    m_Metadata:
      m_Items: []
  - m_Id: 4819106947207168
    m_Localized: "Henry:\n Al fin. Solo un paso m\xE1s para obtener mi matr\xEDcula.\n
      Solo un examen pr\xE1ctico m\xE1s\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4819661035737088
    m_Localized: "Henry:\n \xA1Aprob\xE9! No veo la hora de volver a casa, pedir
      una pizza y tomar una buena cerveza.\n \xA1Hoy se festeja a lo grande!"
    m_Metadata:
      m_Items: []
  - m_Id: 4820711591448576
    m_Localized: "\xA1AAH! \xA1AYUDA! \xA1QUE ALGUIEN DETENGA A ESE LADR\xD3N!"
    m_Metadata:
      m_Items: []
  - m_Id: 4821001459798016
    m_Localized: "Henry:\n Oh, no, otro robo.\n Estoy harto de tanto crimen, pero
      no deber\xEDa meterme."
    m_Metadata:
      m_Items: []
  - m_Id: 4821572887580672
    m_Localized: "Henry:\n Mejor me voy\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4821667880177664
    m_Localized: "Ladr\xF3n:\n JA, JA, JA.\n Esos idiotas siguen busc\xE1ndome y
      la polic\xEDa tardar\xE1 en llegar."
    m_Metadata:
      m_Items: []
  - m_Id: 4822112983912448
    m_Localized: "Ladr\xF3n:\n Nada como entrar en calor antes de un gran golpe."
    m_Metadata:
      m_Items: []
  - m_Id: 4822278373707776
    m_Localized: "Henry:\n Es el ladr\xF3n de antes\u2026 No deber\xEDa meterme,
      no es mi problema. Pero\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4822514596909056
    m_Localized: "Henry:\n Ey, t\xFA\u2026 Dev- \xA1DEVUELVE LO QUE ROBASTE SI NO
      QUIERES SALIR HERIDO!"
    m_Metadata:
      m_Items: []
  - m_Id: 4822907716440064
    m_Localized: "Ladr\xF3n:\n \xA1\xBFEh?! \xA1JA, JA, JA, JA!\n No me hagas re\xEDr,
      muchacho. \xBFAcaso quieres morir?"
    m_Metadata:
      m_Items: []
  - m_Id: 4823150222708736
    m_Localized: "Ladr\xF3n:\n Ven, ac\xE9rcate. Voy a cumplir tu deseo\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4824515917451264
    m_Localized: "Henry:\n \xA1Oh, cielos! No respira\u2026 \xA1\xBFQu\xE9 hice?!"
    m_Metadata:
      m_Items: []
  - m_Id: 4825052150829056
    m_Localized: "Henry:\n Se le cay\xF3 una nota. \xBFEstar\xE1 relacionada con
      el \"gran golpe\" que mencion\xF3?"
    m_Metadata:
      m_Items: []
  - m_Id: 4825284913729536
    m_Localized: "Henry:\n Me llevar\xE9 esto. \xA1Debo irme antes que alguien m\xE1s
      me vea!"
    m_Metadata:
      m_Items: []
  - m_Id: 4874086471241728
    m_Localized: "Propietario:\n \xBFQu\xE9 quieres? Ah, eres el plomero.\n La aver\xEDa
      est\xE1 en el ba\xF1o del piso de abajo.\n Ahora no me molestes, que debo atender
      un llamado."
    m_Metadata:
      m_Items: []
  - m_Id: 4874525191245824
    m_Localized: "Henry:\n\xA1Bien! \xA1Otro trabajo bien hecho!"
    m_Metadata:
      m_Items: []
  - m_Id: 4874897846767616
    m_Localized: "Henry:\n \xBFMmm? Puedo escuchar desde esta ventila hacia la habitaci\xF3n
      de arriba."
    m_Metadata:
      m_Items: []
  - m_Id: 4875093607518208
    m_Localized: "Propietario:\n \u2026luego del intento de secuestro fallido del
      otro d\xEDa, muchos empiezan a preocuparse.\n Incluso los bancos, no podemos
      demorarnos m\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 4875608764518400
    m_Localized: "Propietario:\n Para ma\xF1ana aumentar\xE1n la seguridad.\n Debemos
      terminar el boquete hacia la b\xF3veda esta noche."
    m_Metadata:
      m_Items: []
  - m_Id: 4877109146750976
    m_Localized: "Propietario:\r\n \u2026 \r\n NO ME IMPORTA SI PARTE DEL GRUPO EST\xC1
      EN EL FUNERAL, VE POR TU AUTO Y TR\xC1ELOS COMO SEA."
    m_Metadata:
      m_Items: []
  - m_Id: 4877423086211072
    m_Localized: "Propietario:\n El Jefe nos eliminar\xE1 si fallamos este trabajo.\n
      Nuestras cabezas est\xE1n en juego."
    m_Metadata:
      m_Items: []
  - m_Id: 4877656016883712
    m_Localized: "Propietario:\n S\xED. Esta noche en la obra de construcci\xF3n
      al lado del banco.\n No lo olvides."
    m_Metadata:
      m_Items: []
  - m_Id: 4877808052015104
    m_Localized: "Henry:\n Obra de construcci\xF3n\u2026 Esta noche\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4878111925145600
    m_Localized: "Henry:\n Tal vez deba hacerles una visita."
    m_Metadata:
      m_Items: []
  - m_Id: 4878424581148672
    m_Localized: "Henry:\n \xA1Det\xE9nganse si no quieren salir heridos!"
    m_Metadata:
      m_Items: []
  - m_Id: 4878876462878720
    m_Localized: "Ladr\xF3n:\n \xBFY este qui\xE9n es?"
    m_Metadata:
      m_Items: []
  - m_Id: 4879005479669760
    m_Localized: "Ladr\xF3n:\n \xBFSer\xE1 el justiciero del que tanto hablan en
      las noticias? \xBFEl que detuvo el secuestro?"
    m_Metadata:
      m_Items: []
  - m_Id: 4879341191761920
    m_Localized: "Ladr\xF3n:\n \xBFEste in\xFAtil? \xA1Qu\xE9 bajo hemos ca\xEDdo!\n
      Como sea, no podemos permitir que arruine todo nuestro esfuerzo. Acab\xE9moslo."
    m_Metadata:
      m_Items: []
  - m_Id: 4879585530941440
    m_Localized: "Henry:\n Ay. Eso s\xED me doli\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 4879927987474432
    m_Localized: "Henry:\n Pero no puedo evitarlo, esta adrenalina que siento por
      hacer lo correcto se apodera de m\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 4880427713630208
    m_Localized: "Henry:\n Alguien debe mantener las calles limpias de tantos malhechores.\n
      \xA1Y ese ser\xE9 yo!"
    m_Metadata:
      m_Items: []
  - m_Id: 4880638435463168
    m_Localized: "Henry:\n \xA1Oh-oh!\n Se oyen las sirenas de la polic\xEDa. Hora
      de irse."
    m_Metadata:
      m_Items: []
  - m_Id: 4881033643757568
    m_Localized: "Henry:\n As\xED que son parte de un grupo criminal organizado m\xE1s
      grande.\n Creo que esto se torna cada vez m\xE1s peligroso."
    m_Metadata:
      m_Items: []
  - m_Id: 8814290064183296
    m_Localized: "Due\xF1o de la tienda:\n Disculpa muchacho, estamos haciendo reformas."
    m_Metadata:
      m_Items: []
  - m_Id: 8814853178855424
    m_Localized: "Due\xF1o de la tienda:\n Vuelve la proxima semana"
    m_Metadata:
      m_Items: []
  - m_Id: 32784372209356800
    m_Localized: "Henry:\r\n\xBFQu\xE9 fue eso? \xBFHay alguien m\xE1s ah\xED?"
    m_Metadata:
      m_Items: []
  - m_Id: 32784375422193664
    m_Localized: "Henry:\r\n\xA1Ser\xE1 mejor que vaya a ver!"
    m_Metadata:
      m_Items: []
  - m_Id: 32784377741643776
    m_Localized: "Henry: \r\n\xA1\xBFQui\xE9n mierda eres t\xFA!?"
    m_Metadata:
      m_Items: []
  - m_Id: 32784864280907776
    m_Localized: "Boss:\r\n\xA1Tu peor pesadilla, ni\xF1ito!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
